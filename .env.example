# Copy this file to .env.local (or .env) and fill in your key.
# Either .env or .env.local works; if BOTH exist, .env.local wins — so do not
# leave an empty SARVAM_API_KEY in .env.local, it will shadow the real one.
# ============================================================
# LLM PROVIDER — the app is provider-agnostic by design.
# ============================================================
# The agent talks only to the LLMProvider interface in src/lib/llm/types.ts,
# so switching providers means changing this var (and its key below).
# Supported: sarvam (default) | openai
LLM_PROVIDER=sarvam

# --- Sarvam (default) ---------------------------------------
# Get a key at https://dashboard.sarvam.ai
# Server-side only. NEVER prefix with NEXT_PUBLIC_ — that ships it to the browser.
SARVAM_API_KEY=

# Optional overrides. The defaults are verified against the live API.
# SARVAM_BASE_URL=https://api.sarvam.ai/v1
# SARVAM_MODEL=sarvam-105b

# Capability flags. Sarvam does support streamed tool calls, but the app does
# not depend on them: phase 2 runs one call per slide, so slides stream in
# visibly either way. Left off by default as the safer path.
# SARVAM_STREAMING_TOOL_CALLS=1
# SARVAM_TOOL_CALLING=0           # force the JSON-schema fallback path

# --- OpenAI (alternative) -----------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# --- Images -------------------------------------------------
# Optional. Without a key, images resolve to a keyword-based Unsplash URL.
# UNSPLASH_ACCESS_KEY=

# --- Analytics (PostHog) ------------------------------------
# Optional. Without a token, analytics is a no-op (src/instrumentation-client.ts).
# NEXT_PUBLIC_ is correct here: a PROJECT token is a write-only ingest key and
# is designed to be public. Do NOT put a personal API key (phx_...) here.
# The host is also read by src/proxy.ts to allow it in the CSP's connect-src —
# change it in one place only.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
